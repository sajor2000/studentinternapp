# App
# Check deployment env shape with: npm run preflight
NEXT_PUBLIC_APP_NAME="RHEAS Intern AI Chat"
APP_BASE_URL="http://localhost:3000"
# Must be a random value of at least 32 characters; the placeholder is rejected at runtime.
SESSION_SECRET="replace-with-long-random-secret"

# Predefined users. Initialize app tables with `npm run init-app-db`,
# then seed these into Neon with: npm run seed-users.
# The app can read this directly only when DATABASE_URL is empty or
# AUTH_ALLOW_ENV_FALLBACK="true". Do not enable fallback in production.
# Generate the default 6 intern + admin JSON with: npm run generate-users
# Add --smoke-env to print matching SMOKE_* exports for runtime smoke.
# Generate an individual replacement hash with: npm run hash-password -- '<temporary-password>'
# workflowMode controls which workflow is enabled for each account:
# - "neon": HealthMap/Neon schema and ward workflows
# - "phi_local": PHI-scrubbed local/Rush-machine notebook and code workflows
# - "dual": both modes; default for backwards compatibility
# Example shape for 6 interns plus one admin:
# INTERN_USERS_JSON='[{"username":"intern01","displayName":"Intern 01","role":"intern","workflowMode":"neon","passwordHash":"$2b$..."},{"username":"intern02","displayName":"Intern 02","role":"intern","workflowMode":"phi_local","passwordHash":"$2b$..."},{"username":"admin","displayName":"Admin","role":"admin","workflowMode":"dual","passwordHash":"$2b$..."}]'
AUTH_ALLOW_ENV_FALLBACK="false"
INTERN_USERS_JSON=""
LOGIN_MAX_FAILED_ATTEMPTS="5"
LOGIN_RATE_LIMIT_WINDOW_SECONDS="900"
LOGIN_LOCK_SECONDS="900"
LOGIN_REQUEST_MAX_BYTES="4096"

# Database
# DATABASE_URL is for app metadata such as users, recipes, artifacts, and usage logs.
# TARGET_DATABASE_URL is for local restore tools and must use Neon's direct,
# unpooled owner URL. Never use a -pooler host for pg_restore.
TARGET_DATABASE_URL=""
DATABASE_URL=""
# READONLY_DATABASE_URL is for intern-facing teaching-data query endpoints.
# Use the approved read-only role, for example intern_reader; do not use owner,
# admin, loader, write, root, superuser, or service-role URLs here.
READONLY_DATABASE_URL=""

# AI provider routing
# Recommended Azure route mapping for the current resource group deployments:
# Available Azure model base names/deployments in this resource group:
# gpt-4.1, gpt-5-mini, gpt-5.3-codex, gpt-5.4, gpt-5.4-mini, gpt-5.5.
# - cheap -> gpt-5.4-mini
# - default/code -> gpt-5.3-codex
# - strong -> gpt-5.4
# - premium -> gpt-5.5
# Keep gpt-5-mini and gpt-4.1 available as manual fallback routes, not as defaults.
AI_PROVIDER="azure"
# Server-side kill switch for token spend incidents. Set "false" to return
# 503 from /api/chat before prompts, schema, or model calls are processed.
AI_CHAT_ENABLED="true"
# Server-side prompt size limits. Oversized chats return 400 before schema
# lookup, model routing, or Foundry/Azure calls are attempted.
AI_MAX_CHAT_MESSAGES="40"
AI_MAX_CHAT_TEXT_CHARS="20000"
# Optional cost-control cap. Use "code" to disable strong/premium escalation
# while keeping CE and notebook workflows on the coding model; use "cheap" for
# emergency low-cost mode. Leave empty or set "premium" for normal routing.
AI_MAX_MODEL_TIER="premium"

# OpenAI API
# Local development fallback only. Production and Vercel runtimes reject
# AI_PROVIDER="openai" and default to Azure/Foundry even if this key is present.
OPENAI_API_KEY=""
OPENAI_MODEL_CHEAP="gpt-5.4-mini"
OPENAI_MODEL_DEFAULT="gpt-5.3-codex"
OPENAI_MODEL_CODE="gpt-5.3-codex"
OPENAI_MODEL_STRONG="gpt-5.4"
OPENAI_MODEL_PREMIUM="gpt-5.5"

# Microsoft Foundry / Azure AI
# The Foundry REST sample uses Authorization: Bearer $AZURE_API_KEY against
# /openai/responses?api-version=2025-04-01-preview. This app uses the same
# Bearer key through the server-side AI SDK provider.
# The app accepts either the resource endpoint below or the full
# /openai/responses?... URL and normalizes it to the base /openai path.
AZURE_AI_ENDPOINT="https://equityclaudeagent.cognitiveservices.azure.com"
# Set AZURE_AI_API_KEY locally/in Vercel. AZURE_API_KEY is also accepted as an alias.
AZURE_AI_API_KEY=""
AZURE_AI_API_VERSION="2025-04-01-preview"
AZURE_AI_CHEAP_DEPLOYMENT="gpt-5.4-mini"
AZURE_AI_DEFAULT_DEPLOYMENT="gpt-5.3-codex"
AZURE_AI_CODE_DEPLOYMENT="gpt-5.3-codex"
AZURE_AI_STRONG_DEPLOYMENT="gpt-5.4"
AZURE_AI_PREMIUM_DEPLOYMENT="gpt-5.5"
# Replace these with the actual Rush/Azure agreement prices for the configured
# region and deployment type. Values are USD per 1M tokens.
AZURE_AI_CHEAP_INPUT_USD_PER_1M="0.75"
AZURE_AI_CHEAP_OUTPUT_USD_PER_1M="4.5"
AZURE_AI_DEFAULT_INPUT_USD_PER_1M="1.75"
AZURE_AI_DEFAULT_OUTPUT_USD_PER_1M="14"
AZURE_AI_CODE_INPUT_USD_PER_1M="1.75"
AZURE_AI_CODE_OUTPUT_USD_PER_1M="14"
AZURE_AI_STRONG_INPUT_USD_PER_1M="2.5"
AZURE_AI_STRONG_OUTPUT_USD_PER_1M="15"
AZURE_AI_PREMIUM_INPUT_USD_PER_1M="5"
AZURE_AI_PREMIUM_OUTPUT_USD_PER_1M="30"

# Imported teaching schema
# The production pg_dump uses public; keep this public for live-DB parity.
HEALTHMAP_SCHEMA="public"
SCHEMA_CACHE_TTL_SECONDS="3600"

# Cost controls
MONTHLY_TOKEN_BUDGET_USD="100"
PER_USER_DAILY_BUDGET_USD="5"
AI_RATE_LIMIT_REQUESTS="20"
AI_RATE_LIMIT_WINDOW_SECONDS="60"
MAX_PREVIEW_ROWS="100"
MAX_EXPORT_ROWS="50000"
QUERY_RATE_LIMIT_REQUESTS="30"
QUERY_RATE_LIMIT_WINDOW_SECONDS="60"
QUERY_TIMEOUT_MS="15000"
UPLOAD_RATE_LIMIT_REQUESTS="20"
UPLOAD_RATE_LIMIT_WINDOW_SECONDS="300"
# Coarse request-body guards for metadata JSON before parsing.
APP_METADATA_MAX_BYTES="524288"
ARTIFACT_METADATA_MAX_BYTES="16384"
AZURE_UPLOAD_METADATA_MAX_BYTES="16384"

# Artifact storage
# Azure Blob is the selected controlled-file/artifact provider.
# Keep this server-side only. The app issues short-lived upload-only SAS URLs
# for private blob paths and never returns a public read URL.
AZURE_STORAGE_CONNECTION_STRING=""
AZURE_STORAGE_CONTAINER="summer-intern-uploads"
AZURE_UPLOAD_MAX_BYTES="104857600"
# Short-lived direct-upload SAS expiry. Must be 1-15 minutes; 10 is recommended.
AZURE_UPLOAD_SAS_MINUTES="10"

# Runtime smoke test inputs. Use real seeded credentials locally or in CI only;
# do not commit populated values. APP_BASE_URL points at local dev or Vercel.
SMOKE_NEON_USERNAME=""
SMOKE_NEON_PASSWORD=""
SMOKE_NEON_WORKFLOW_MODE="neon"
SMOKE_PHI_USERNAME=""
SMOKE_PHI_PASSWORD=""
SMOKE_PHI_WORKFLOW_MODE="phi_local"
SMOKE_ADMIN_USERNAME=""
SMOKE_ADMIN_PASSWORD=""
SMOKE_ADMIN_WORKFLOW_MODE="dual"
SMOKE_TEST_PUBLIC="0"
SMOKE_TEST_UPLOAD="0"
SMOKE_TEST_CHAT="0"

# Legacy/alternate storage options, not used by the current upload path.
BLOB_READ_WRITE_TOKEN=""
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Optional server-side public documentation lookup for the chat route.
# Context7 is an external third-party docs service. Only generic public library
# documentation queries may be sent to it. Never include PHI, PII, credentials,
# private code, file names, database URLs, blob paths, or controlled data values.
CONTEXT7_ENABLED="false"
# Required when CONTEXT7_ENABLED="true"; use a free Context7 key if appropriate.
CONTEXT7_API_KEY=""

# Optional local tool setup only, not required by the web app runtime.
# Do not expose this in browser code.
NEON_API_KEY=""
